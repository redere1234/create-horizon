{
  "multipart": [
    {
      "apply": {
        "model": "create:block/fluid_pipe/fallback_core"
      }
    },
    {
      "when": {
        "down": "true"
      },
      "apply": {
        "model": "create:block/fluid_pipe/fallback_down"
      }
    },
    {
      "when": {
        "up": "true"
      },
      "apply": {
        "model": "create:block/fluid_pipe/fallback_up"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "create:block/fluid_pipe/fallback_north"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "create:block/fluid_pipe/fallback_south"
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "create:block/fluid_pipe/fallback_west"
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "create:block/fluid_pipe/fallback_east"
      }
    }
  ]
}
